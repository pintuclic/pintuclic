# ==============================================================================
# PINTUCLIC - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a .env y define tus valores confidenciales.
# ==============================================================================

# 1. Base de Datos (PostgreSQL)
POSTGRES_USER=pintuclic
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=pintuclic
BACKEND_PORT=3000
FRONTEND_PORT=80

# 2. JWT y Seguridad
JWT_SECRET=tu_jwt_secret_largo_y_seguro_para_produccion
JWT_REFRESH_SECRET=tu_jwt_refresh_secret_largo_y_seguro

# 3. Notificaciones y Correo Transaccional (M18 SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_clave_de_aplicacion_16_caracteres
SMTP_FROM="Pintu Clic <notificaciones@pintuclic.com>"
SMTP_REPLY_TO=soporte@pintuclic.com
SMTP_SIMULACION=false

# 4. Google Identity Services (OAuth 2.0 / HU-CUE-02)
# ID de cliente de aplicación web obtenido en Google Cloud Console
GOOGLE_CLIENT_ID=tu_cliente_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=tu_cliente_id.apps.googleusercontent.com
