# Copiar a container/.env y ajustar los valores:
#   cp container/.env.example container/.env
#
# container/.env NO se versiona (ver container/.gitignore).
# La contraseña debe ser alfanumérica (sin @ : / #) porque va embebida en DATABASE_URL.

POSTGRES_USER=pintuclic
POSTGRES_PASSWORD=cambiar_por_una_clave_fuerte_aleatoria
POSTGRES_DB=pintuclic

# Opcionales (puertos expuestos en el host):
# BACKEND_PORT=3000
# FRONTEND_PORT=80