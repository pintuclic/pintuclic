# ==============================================================================
# Plantilla de entorno del backend de Pintuclic.
# Copiar a `backend/.env` y ajustar a la máquina de cada quien.
# El .env real está en .gitignore y NUNCA debe versionarse.
# ==============================================================================

# --- Base de datos -----------------------------------------------------------
# Ajusta el puerto: una instalación nativa de PostgreSQL suele usar 5432, pero
# si tenías una versión anterior instalada, la nueva pudo quedar en 5433.
# Para verificarlo: busca la línea `port =` en el postgresql.conf de tu instalación.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pintuclic
POSTGRES_USER=pintuclic
POSTGRES_PASSWORD=cambia_esta_clave

# Alternativa: una sola cadena de conexión, que tiene prioridad sobre lo anterior.
# DATABASE_URL=postgres://pintuclic:cambia_esta_clave@localhost:5432/pintuclic

# --- Servidor HTTP -----------------------------------------------------------
PORT=3000
NODE_ENV=development

# Muestra el detalle técnico de los errores en la respuesta HTTP.
# Solo en local: en producción el mensaje siempre es genérico (HU-SEG-06).
EXPONER_DETALLE_ERRORES=true

# --- M20: Seguridad ----------------------------------------------------------
# Claves de firma de los JWT. CAMBIAR en cualquier entorno que no sea local.
# Si las cambias, los tokens emitidos antes dejan de ser válidos.
JWT_SECRET=cambia_esta_clave_de_firma_en_produccion
JWT_REFRESH_SECRET=cambia_esta_clave_de_refresco_en_produccion

# Lista de id_rol considerados administrativos, separados por coma.
# Determina qué sesiones usan la ventana de inactividad corta (RF-SEG-02-02).
ROLES_ADMINISTRATIVOS=1

# Ventanas de inactividad en segundos. Si se omiten, se aplican los valores
# de la política: 1800 (30 min) para admin y 2592000 (30 días) para cliente.
# SESION_INACTIVIDAD_ADMIN_SEGUNDOS=1800
# SESION_INACTIVIDAD_CLIENTE_SEGUNDOS=2592000
